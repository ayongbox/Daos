<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ayongbox.daos</groupId>
        <artifactId>daos-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>daos-web</artifactId>
    <name>daos-web</name>
    <description>控制台 REST API、装配与启动</description>

    <dependencies>
        <dependency>
            <groupId>io.github.ayongbox.daos</groupId>
            <artifactId>daos-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox.daos</groupId>
            <artifactId>daos-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox.daos</groupId>
            <artifactId>daos-license</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-swagger</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-log</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>io.github.ayongbox.daos.web.DaosApplication</mainClass>
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
