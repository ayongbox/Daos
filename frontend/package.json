{
  "name": "daos-frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:console": "pnpm --filter @daos/console dev",
    "dev:runtime": "pnpm --filter @daos/runtime dev",
    "check:forbidden": "node tooling/scripts/check-forbidden-tokens.mjs",
    "check:schema": "node tooling/scripts/check-schema-sync.mjs",
    "check": "pnpm run check:forbidden && pnpm run check:schema"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "@vitejs/plugin-react": "^4.3.3"
  }
}
